<!-- ===================== TRAINING HERO ===================== -->
<section class="page-hero">
    <div class="page-hero-shapes" aria-hidden="true">
      
    </div>
    <div class="container">
      <div class="page-hero-eyebrow">Learn &amp; Grow</div>
      <h1>Guidance &amp; Training</h1>
      <p>Practical courses, expert guides, and hands-on support to build real farming and business skills.</p>
    </div>
  </section>

  <section class="training-section">
    <div class="container">

      <!-- ===================== CATEGORY FILTER PILLS ===================== -->
      <div class="training-filters" id="trainingFilters">
        <button type="button" class="training-pill is-active" data-filter="all">All Programs</button>
        <button type="button" class="training-pill" data-filter="crop">Crop Production</button>
        <button type="button" class="training-pill" data-filter="livestock">Livestock</button>
        <button type="button" class="training-pill" data-filter="agribusiness">Agribusiness</button>
        <button type="button" class="training-pill" data-filter="finance">Financial Literacy</button>
      </div>

      <!-- ===================== PROGRAM GRID ===================== -->
      <!-- ===================== PROGRAM GRID ===================== -->
<div class="training-grid" id="trainingGrid">

  <% if (trainings && trainings.length > 0) { %>
    <% trainings.forEach(t => { %>
      <div class="training-card" data-category="<%= t.category %>">
        <div class="training-thumb"(<%= t.gradient_start %>,<%= t.gradient_end %>);>
          <i class="bi <%= t.icon %>"></i>
        </div>
        <div class="training-body">
          <span class="training-tag"><%= t.category.charAt(0).toUpperCase() + t.category.slice(1) %></span>
          <h3><%= t.title %></h3>
          <div class="training-meta">
            <span><i class="bi bi-clock"></i> <%= t.duration %></span>
            <span><i class="bi bi-bar-chart"></i> <%= t.level %></span>
          </div>
          <a href="/account/login" class="btn btn-filled training-enroll">Enroll Now</a>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="text-align:center; color: var(--text-muted); padding: 40px 0;">No training programs available right now.</p>
  <% } %>

</div>
      <!-- ===================== NO RESULTS ===================== -->
      <div class="training-empty" id="trainingEmpty">
        <i class="bi bi-emoji-frown"></i>
        <h3>No programs in this category yet</h3>
        <p>Check back soon, or explore all available programs.</p>
      </div>

      <!-- ===================== DOWNLOADABLE GUIDES ===================== -->
      <div class="training-guides-list">
        <% if (guides && guides.length > 0) { %>
          <% guides.forEach(g => { %>
            <a href="<%= g.file_path %>" target="_blank" class="training-guide-item">
              <i class="bi bi-file-earmark-text"></i>
              <div>
                <h4><%= g.title %></h4>
                <span>PDF Guide<%= g.page_count ? ' &middot; ' + g.page_count + ' pages' : '' %></span>
              </div>
              <i class="bi bi-download guide-download-icon"></i>
            </a>
          <% }) %>
        <% } else { %>
          <p style="color: var(--text-muted); padding: 20px 0;">No guides uploaded yet.</p>
        <% } %>
      </div>

      <!-- ===================== REQUEST TRAINING CTA ===================== -->
      <div class="training-cta">
        <div>
          <h3>Need training for your group or cooperative?</h3>
          <p>Request a customized on-site training session from our field team.</p>
        </div>
        <a href="/contact" class="btn btn-filled">Request Training</a>
      </div>

    </div>
  </section>