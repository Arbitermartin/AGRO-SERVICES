<!-- ===================== TEAM PAGE HERO ===================== -->
<section class="page-hero">
  <div class="page-hero-shapes" aria-hidden="true">
    <i class="bi bi-people"></i>
    <i class="bi bi-flower1"></i>
  </div>
  <div class="container">
    <div class="page-hero-eyebrow">Meet Us</div>
    <h1>Our Team</h1>
    <p>The people driving AgroServices' mission across Tanzania.</p>
  </div>
</section>

<section class="team-section">
  <div class="container">

    <!-- ===================== LEADERSHIP TEAM ===================== -->
   <h2 class="section-heading">LEADERSHIP TEAM</h2>
<div class="team-grid">
  <% if (leadershipTeam && leadershipTeam.length > 0) { %>
    <% leadershipTeam.forEach(m => { %>
      <div class="team-card">
        <div class="team-card-photo" <% if (!m.photo_path) { %>style="background: linear-gradient(135deg, #66BB6A, #2E7D32); display:flex; align-items:center; justify-content:center;"<% } %>>
          <% if (m.photo_path) { %>
            <img src="<%= m.photo_path %>" alt="<%= m.full_name %>" style="width:100%; height:100%; object-fit:cover;">
          <% } else { %>
            <i class="bi bi-person-fill" style="color:rgba(255,255,255,0.9); font-size:3.2rem;"></i>
          <% } %>
        </div>
        <div class="team-card-body">
          <h3><%= m.full_name %></h3>
          <p class="team-card-title"><%= m.title %></p>
          <div class="team-card-social">
            <% if (m.linkedin_url) { %><a href="<%= m.linkedin_url %>" target="_blank" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a><% } %>
            <% if (m.twitter_url) { %><a href="<%= m.twitter_url %>" target="_blank" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a><% } %>
            <% if (m.email) { %><a href="mailto:<%= m.email %>" aria-label="Email"><i class="bi bi-envelope"></i></a><% } %>
          </div>
          <% if (m.bio) { %>
            <button type="button" class="team-bio-toggle"><span>Read Bio</span> <i class="bi bi-chevron-down"></i></button>
            <p class="team-bio-text"><%= m.bio %></p>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="color: var(--text-muted);">Team information coming soon.</p>
  <% } %>
</div>

<h2 class="section-heading" style="margin-top: 60px;">ADVISORY BOARD</h2>
<div class="team-grid">
  <% if (advisoryBoard && advisoryBoard.length > 0) { %>
    <% advisoryBoard.forEach(m => { %>
      <div class="team-card">
        <div class="team-card-photo" <% if (!m.photo_path) { %>style="background: linear-gradient(135deg, #8E24AA, #4A148C); display:flex; align-items:center; justify-content:center;"<% } %>>
          <% if (m.photo_path) { %>
            <img src="<%= m.photo_path %>" alt="<%= m.full_name %>" style="width:100%; height:100%; object-fit:cover;">
          <% } else { %>
            <i class="bi bi-person-fill" style="color:rgba(255,255,255,0.9); font-size:3.2rem;"></i>
          <% } %>
        </div>
        <div class="team-card-body">
          <h3><%= m.full_name %></h3>
          <p class="team-card-title"><%= m.title %></p>
          <div class="team-card-social">
            <% if (m.linkedin_url) { %><a href="<%= m.linkedin_url %>" target="_blank" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a><% } %>
            <% if (m.email) { %><a href="mailto:<%= m.email %>" aria-label="Email"><i class="bi bi-envelope"></i></a><% } %>
          </div>
          <% if (m.bio) { %>
            <button type="button" class="team-bio-toggle"><span>Read Bio</span> <i class="bi bi-chevron-down"></i></button>
            <p class="team-bio-text"><%= m.bio %></p>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="color: var(--text-muted);">Advisory board information coming soon.</p>
  <% } %>
</div>

</div>
</section>