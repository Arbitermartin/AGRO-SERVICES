<!-- ===================== ANIMATED STATS COUNTER ===================== -->
<section class="stats-counter-section">
  <div class="container">
    <div class="section-heading" style="text-align:center; margin-bottom: 32px;">
      <p style="color:var(--text-muted); margin-top:8px;">Real numbers from members, events and updates across Tanzania</p>
    </div>
    <div class="stats-counter-grid">

      <!-- Members -->
      <div class="stat-counter-card">
        <div class="stat-counter-icon"><i class="bi bi-people-fill"></i></div>
        <div class="stat-counter-number">
          <span class="count-up" data-target="<%= totalMembers || 0 %>">0</span>+
        </div>
        <div class="stat-counter-label">Members Growing With Us</div>
      </div>

      <!-- Events -->
      <div class="stat-counter-card">
        <div class="stat-counter-icon"><i class="bi bi-calendar-event"></i></div>
        <div class="stat-counter-number">
          <span class="count-up" data-target="<%= totalEvents || 0 %>">0</span>
        </div>
        <div class="stat-counter-label">Upcoming Events</div>
      </div>

      <!-- News -->
      <div class="stat-counter-card">
        <div class="stat-counter-icon"><i class="bi bi-newspaper"></i></div>
        <div class="stat-counter-number">
          <span class="count-up" data-target="<%= totalNews || 0 %>">0</span>
        </div>
        <div class="stat-counter-label">Latest News & Updates</div>
      </div>

    </div>
  </div>
</section>
  <!-- ===================== SERVICES ===================== -->
  <section class="services">
    <div class="container">
      <div class="section-heading">
        <h2>Services We Offer</h2>
        <i class="bi bi-flower2 heading-divider"></i>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon"><i class="bi bi-mortarboard-fill"></i></div>
          <h3>Training Programs</h3>
          <p>Build your skills with practical and modern agriculture training.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><i class="bi bi-clipboard2-pulse-fill"></i></div>
          <h3>Advisory Services</h3>
          <p>Get expert advice for better farm productivity and yield.</p>
        </div>
        <div class="service-card">
          <div class="service-icon"><i class="bi bi-box-seam-fill"></i></div>
          <h3>Input Supply</h3>
          <p>Access quality inputs and farm supplies at affordable prices.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- =====================================================================
         LATEST NEWS & EVENTS - Pure CSS, matches your screenshot exactly
    ====================================================================== -->
    <div class="news-events-section">
      <div class="news-events-grid">

        <!-- LEFT: LATEST NEWS -->
        <div class="news-column">
          <h2 class="section-heading">LATEST NEWS</h2>

          <% 
            // Safe defaults to prevent errors if variables are missing
            let newsItems = latestNews || [];
            let eventItems = upcomingEvents || [];
          %>

          <% if (newsItems.length > 0) { %>
            <% newsItems.forEach(item => { %>
              <div class="news-card">
                <% if (item.profile_image) { %>
                  <div class="news-image">
                    <img src="<%= item.profile_image %>" alt="<%= item.title %>" loading="lazy">
                  </div>
                <% } %>
                <div class="news-content">
                  <h3 class="news-title"><%= item.title %></h3>
                  <p class="news-text"><%= item.description.substring(0, 140) %>...</p>
                  <div class="news-footer">
                    <span class="news-date">
                      <%= new Date(item.news_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                    </span>
                    <a href="/news/<%= item.news_id %>" class="news-more">Read full update →</a>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-message">No recent news posted yet.</div>
          <% } %>
        </div>

        <!-- RIGHT: EVENTS -->
        <div class="events-column">
          <h2 class="section-heading">EVENTS</h2>

          <% if (eventItems.length > 0) { %>
            <% eventItems.forEach(item => { %>
              <div class="event-card">
                <div class="event-badge">
                  <span class="event-day"><%= new Date(item.event_date).getDate() %></span>
                  <span class="event-month"><%= new Date(item.event_date).toLocaleString('default', { month: 'short' }) %></span>
                  <span class="event-year"><%= new Date(item.event_date).getFullYear() %></span>
                </div>
                <div class="event-content">
                  <h3 class="event-title"><%= item.title %></h3>
                  <p class="event-location">
                    <i class="bi bi-geo-alt-fill"></i> <%= item.location || 'Venue TBA' %>
                  </p>
                  <p class="event-text">
                    <%= item.description ? item.description.substring(0, 100) + '...' : 'Details coming soon' %>
                  </p>
                  <a href="/events/<%= item.event_id %>" class="event-link">View event →</a>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-message">No upcoming events scheduled.</div>
          <% } %>
        </div>

      </div>
    </div>
    <!-- End of News & Events -->

  </div>

  <!-- ===================== PARTNERS SLIDER ===================== -->
<section class="partners-section">
  <div class="container">
    <div class="section-heading" style="text-align:center; margin-bottom: 28px;">
      <h2>Our Partners</h2>

      <p style="color:#666;">Trusted organizations we work with</p>
    </div>

    <div class="partners-slider-wrap">
      <div class="partners-track" id="partnersTrack">
        <!-- Partner logos (repeat the list twice for seamless loop) -->
        <div class="partner-logo"><img src="../images/site/crdb.webp" alt="Partner 1"></div>
        <div class="partner-logo"><img src="../images/site/nbc.webp" alt="Partner 2"></div>
        <div class="partner-logo"><img src="../images/site/vijana.webp" alt="Partner 3"></div>
        <div class="partner-logo"><img src="../images/site/tadb.webp" alt="Partner 4"></div>
        <div class="partner-logo"><img src="../images/site/nmb.webp" alt="Partner 5"></div>
        <div class="partner-logo"><img src="../images/site/equity.webp" alt="Partner 6"></div>

        
    </div>
  </div>
</section>
</section>
    <!-- Delivery frequent asked question -->
      <section class="faq-home-section">
        <div class="container">
          <div class="faq-home-header">
            <div class="eyebrow">FAQ</div>
            <h2>Frequently Asked Questions</h2>
            <p>Everything you need to how about joining and using Agroservices Network</p>
          </div>
          <div class="faq-home-list" id="faqHomeList">
            <% if(siteFaqs && siteFaqs.length>0){%>
              <% siteFaqs.forEach((faq,index)=>{%>
                <div class="faq-home-item <%= index === 0? 'is-open': ''%>">
                  <button type="button" class="faq-home-question" aria-expanded="<%=index ===0? 'true': 'false'%>">
                    <span><%= faq.question%></span>
                    <span class="faq-home-icon"><i class="bi <%= index === 0 ? 'bi-dash' : 'bi-plus' %>"></i></span>
                    </button>
                    <div class="faq-home-answer">
                      <p><%= faq.answer%></p>
                      </div>
                  </div>
              <%})%>
            <%} else{%>
            <p style="text-align:center; color:var(--text-muted);">No FAQs posted yet.</p>
          <%}%>

          </div>
        </div>
      </section>


    <!-- ===================== TESTIMONIALS (placed after FAQ) ===================== -->
<section class="testimonials-section">
  <div class="container">
    <h2 class="section-heading" style="text-align:center;">What Our Members Say</h2>

    <% if (testimonials && testimonials.length > 0) { %>
      <div class="testimonial-slider" id="testimonialSlider">
        <% testimonials.forEach((t, i) => { %>
          <div class="testimonial-slide <%= i === 0 ? 'active' : '' %>">
            <i class="bi bi-quote testimonial-quote-icon"></i>
            <p class="testimonial-text">"<%= t.message %>"</p>
            <% if (t.photo_path) { %>
              <img src="<%= t.photo_path %>" alt="<%= t.full_name %>" class="testimonial-avatar-img">
            <% } else { %>
              <div class="testimonial-avatar"><%= t.full_name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %></div>
            <% } %>
            <p class="testimonial-name"><%= t.full_name %></p>
            <% if (t.role_location) { %><span class="testimonial-role"><%= t.role_location %></span><% } %>
          </div>
        <% }) %>
      </div>

      <div class="testimonial-dots" id="testimonialDots"></div>

      <div class="testimonial-controls">
        <button type="button" id="testimonialPrev" aria-label="Previous testimonial"><i class="bi bi-chevron-left"></i></button>
        <button type="button" id="testimonialNext" aria-label="Next testimonial"><i class="bi bi-chevron-right"></i></button>
      </div>
    <% } else { %>
      <p style="text-align:center; color:var(--text-muted);">No testimonials yet.</p>
    <% } %>
  </div>
</section>

    <div class="faq-home-footer">
      <span>Still have questions?</span>
      <a href="/contact">Contact our team <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- ICT Support Status Popup -->
<div id="ictSupportPopup" class="ict-support-popup" style="display:none;">
  <div class="ict-support-popup-content">
    <button type="button" class="ict-support-close" id="ictSupportClose">&times;</button>
    
    <% if (ictOnline) { %>
      <div class="ict-support-icon online">
        <i class="bi bi-headset"></i>
      </div>
      <h4>ICT Support is Online</h4>
      <p>Our support team is available right now. Chat with us if you need help.</p>
      <button type="button" class="btn btn-filled btn-sm" id="openChatFromPopup">
        Start Chat
      </button>
    <% } else { %>
      <div class="ict-support-icon offline">
        <i class="bi bi-headset"></i>
      </div>
      <h4>ICT Support is Offline</h4>
      <p>Our team is currently offline. You can still leave a message or try again later.</p>
      <a href="/contact" class="btn btn-outline btn-sm">Contact Us</a>
    <% } %>
  </div>
</div>
