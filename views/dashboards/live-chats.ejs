<div id="liveChatsPanel" class="db-card" style="display:none;">
  <div class="step-header" style="text-align:center; margin-bottom:24px;">
    <div class="step-number" style="margin:0 auto 12px;"><i class="bi bi-chat-dots"></i></div>
    <h2>Live Chats</h2>
    <p>Respond to visitors waiting for live support</p>
  </div>

  <div id="waitingChatsList"><p style="text-align:center; color:#9ca3af;">Checking for waiting visitors...</p></div>

  <div id="activeChatThread" style="display:none; margin-top:20px;">
    <div id="activeChatMessages" style="max-height:300px; overflow-y:auto; display:flex; flex-direction:column; gap:8px; margin-bottom:12px;"></div>
    <form id="ictChatReplyForm" style="display:flex; gap:8px;">
      <input type="text" id="ictChatReplyInput" placeholder="Type your reply..." style="flex:1; padding:10px 14px; border:1.5px solid var(--border-color); border-radius:20px;" required>
      <button type="submit" style="background:var(--primary-green); color:#fff; border:none; width:38px; height:38px; border-radius:50%;"><i class="bi bi-send"></i></button>
    </form>
  </div>

  <div class="auth-switch" style="margin-top:20px;text-align:center;">
    <a href="#" id="cancelLiveChats"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
  </div>
</div>