<body class="db-body" data-role="member">

  <div class="db-shell">
    <!-- ===================== SIDEBAR ===================== -->
    <aside class="db-sidebar" id="dbSidebar">
      <div class="db-brand">
        <i class="bi bi-shield-fill-check"></i>
        <div>
          <div class="db-brand-name">PORTAL</div>
          <div class="db-brand-sub">Member Panel</div>
        </div>
      </div>

      <nav class="db-nav">
        <a href="/account/dashboard/member" class="db-nav-link is-active">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="#" id="trainingOpportunitiesLink" class="db-nav-link"> 
          <i class="bi bi-mortarboard"></i>Training
        </a>
        <a href="#" id="jobOpportunitiesLink" class="db-nav-link">
          <i class="bi bi-briefcase"></i>Job Opportunities
        </a>
        <a href="#" id="myApplicationsLink" class="db-nav-link">
          <i class="bi bi-file-earmark-text"></i> My Applications</a>
        <a href="#" class="db-nav-link">
          <i class="bi bi-calendar-check"></i> My Registrations
        </a>
        <a href="#" id="updateProfileLink" class="db-nav-link">
          <i class="bi bi-person-gear"></i> Profile Update
       </a>
        <a href="#" id="createTicketLink" class="db-nav-link">
          <i class="bi bi-envelope"></i> support Tickets
        </a>
        <a href="#" id="myMessagesLink" class="db-nav-link">
          <i class="bi bi-life-preserver"></i>Messages
        </a>

        <div class="db-nav-footer">
          <a href="/account/logout" class="db-nav-link"><i class="bi bi-box-arrow-right"></i> Logout</a>
        </div>
      </nav>
    </aside>

    <div class="db-main">
      <!-- ===================== TOP BAR ===================== -->
      <header class="db-topbar">
        <div class="db-topbar-left">
          <button type="button" class="db-sidebar-toggle" id="dbSidebarToggle" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
          </button>
          <div>
            <div class="db-welcome">Welcome, <%= account.full_name %></div>
            <div class="db-role">
              Role:<%= account.account_type %>
              <% if (account.is_online){%>
              <span class="online-status"><span class="online-dot"></span> Online</span>
              <%}%>
            </div>
          </div>
        </div>

        <div class="db-topbar-title">MEMBER DASHBOARD</div>

        <div class="db-topbar-right">
   
         <div class="db-search" style="position: relative;">
          <i class="bi bi-search"></i>
          <input type="text" id="dashboardSearchInput" placeholder="Search tickets or users...">
          <div id="dashboardSearchResults" class="search-results-dropdown" style="display:none;"></div>
        </div>

        <!-- 
          <div class="db-search">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search...">
          </div> -->

          <!-- <button type="button" class="db-icon-btn" aria-label="Notifications">
            <i class="bi bi-bell"></i>
            <span class="db-notif-dot"></span>
          </button> -->
       <div class="db-notif-menu">
           <button type="button" class="db-icon-btn" id="notifToggle" aria-label="Notifications">
           <i class="bi bi-bell"></i>
             <span class="db-notif-count" id="notifCount" style="display:none;">0</span>
              </button>
           <div class="db-notif-dropdown" id="notifDropdown">
           <div class="db-notif-header">
            <span>Notifications</span>
            <a href="#" id="markAllReadBtn">Mark all read</a>
           </div>
          <div class="db-notif-list" id="notifList">
          <p class="db-notif-empty">Loading...</p>
         </div>
       </div>
      </div>

          <div class="db-user-menu">
            <button type="button" class="db-user-toggle" id="dbUserToggle" aria-haspopup="true" aria-expanded="false">
              <span class="db-avatar"><%=initials%></span>
              <span class="db-user-name"><%=account.full_name%></span>
              <i class="bi bi-chevron-down db-user-caret"></i>
            </button>

            <div class="db-user-dropdown" id="dbUserDropdown">
              <div class="db-user-dropdown-head">
                <span class="db-avatar db-avatar-lg"><%= initials %></span>
                <div>
                  <div class="db-user-dropdown-name"><%= account.full_name %></div>
                  <div class="db-user-dropdown-email"><%= account.email %></div>
                </div>
              </div>
              <div class="db-user-dropdown-divider"></div>
              <a href="#" id="updateProfileLink" class="db-user-dropdown-item">
                <i class="bi bi-person"></i> Update Profile
              </a>
              <a href="#" id="changePasswordLink" class="db-user-dropdown-item">
                <i class="bi bi-key"></i> Change Password
              </a>
              <div class="db-user-dropdown-divider"></div>
               <a href="/account/logout" class="db-user-dropdown-item db-user-dropdown-danger"><i class="bi bi-box-arrow-right"></i> Logout</a>
              </a>
            </div>
          </div>
        </div>
      </header>

      <div class="db-content">
        <div id="toastContainer" class="toast-container">
          <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <% success.forEach(msg => { %>
              <div class="toast-msg success">
                <i class="bi bi-check-circle-fill"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          <% } else if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <% error.forEach(msg => { %>
              <div class="toast-msg error">
                <i class="bi bi-x-circle-fill"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          <% } %>
        </div> <div id="toastContainer" class="toast-container">
          <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <% success.forEach(msg => { %>
              <div class="toast-msg success">
                <i class="bi bi-check-circle-fill"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          <% } else if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <% error.forEach(msg => { %>
              <div class="toast-msg error">
                <i class="bi bi-x-circle-fill"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          <% } %>
        </div>


        <!-- ===================== MAIN DASHBOARD CONTENT ===================== -->
        <div id="dbMainContent">

          <!-- ===================== STAT CARDS ===================== -->
          <div class="db-stats-grid db-stats-grid-4">
            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-green"><i class="bi bi-mortarboard-fill"></i></div>
              <div>
                <div class="db-stat-label">My Trainings</div>
                <div class="db-stat-value">5</div>
                <div class="db-stat-delta db-stat-delta-green">Registered</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-purple"><i class="bi bi-briefcase-fill"></i></div>
              <div>
                <div class="db-stat-label">Jobs Applied</div>
                <div class="db-stat-value"><%= myApplicationsCount %></div>
                <div class="db-stat-delta db-stat-delta-purple">Total applications</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-red"><i class="bi bi-calendar-check-fill"></i></div>
              <div>
                <div class="db-stat-label">Event Registrations</div>
                <div class="db-stat-value">2</div>
                <div class="db-stat-delta db-stat-delta-red">Upcoming</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-orange"><i class="bi bi-person-check-fill"></i></div>
              <div>
                <div class="db-stat-label">Profile Completion</div>
                <div class="db-stat-value">85%</div>
                <div class="db-stat-delta db-stat-delta-orange">Complete</div>
              </div>
            </div>
          </div>
           <!-- ===================== MY LEARNING ===================== ✅ ADD HERE -->
  <div class="db-card">
    <div class="db-panel-title">My Learning</div>

    <% if (myLearningProgress && myLearningProgress.length > 0) { %>
      <div class="db-member-panels-grid">
        <% myLearningProgress.forEach(item => { %>
          <div class="training-card">
            <div class="training-thumb" style="background:linear-gradient(135deg,#66BB6A,#2E7D32);">
              <i class="bi bi-mortarboard"></i>
            </div>
            <div class="training-body">
              <span class="training-tag"><%= item.category.charAt(0).toUpperCase() + item.category.slice(1) %></span>
              <h3><%= item.title %></h3>

              <div style="height:4px; background:#e0e0e0; border-radius:2px; margin:10px 0 6px;">
                <div class="learning"<%= item.progress_percent %>%;></div>
              </div>
              <div class="training-meta" style="margin-bottom:14px;">
                <span><%= item.completed_lessons %> of <%= item.total_lessons %> lessons complete</span>
              </div>

              <% if (!item.has_lessons) { %>
                <button type="button" class="btn btn-outline training-enroll" disabled>No lessons yet</button>
              <% } else if (item.progress_percent === 0) { %>
                <a href="/account/lessons/<%= item.next_lesson_id %>" class="btn btn-filled training-enroll">Start Learning</a>
              <% } else if (item.progress_percent === 100) { %>
                <a href="/account/lessons/<%= item.next_lesson_id %>" class="btn btn-outline training-enroll">
                  <i class="bi bi-check-circle"></i> Completed &mdash; Review
                </a>
              <% } else { %>
                <a href="/account/lessons/<%= item.next_lesson_id %>" class="btn btn-filled training-enroll">Continue Learning</a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="text-align:center; color:#9ca3af; padding: 24px;">You haven't registered for any training yet.</p>
    <% } %>
  </div>

          <!-- ===================== TRAININGS + JOB OPPORTUNITIES ===================== -->
          <div class="db-member-panels-grid">

            <div class="db-card">
              <div class="db-panel-title">Upcoming Trainings</div>
            
              <table class="db-table">
                <thead>
                  <tr>
                    <th>Training</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (typeof upcomingTrainings !== 'undefined' && upcomingTrainings.length > 0) { %>
                    <% upcomingTrainings.forEach(training => { %>
                      <tr>
                        <td><%= training.title %></td>
                        <td>
                          <%= new Date(training.start_date).toLocaleDateString('en-GB', {
                            day: 'numeric',
                            month: 'short',
                            year: 'numeric'
                          }) %>
                        </td>
                        <td><%= training.location || 'Online' %></td>
                        <td>
                          <span class="db-badge-status db-badge-open">
                            <%= training.status || 'Open' %>
                          </span>
                        </td>
                        <td>
                          <% if (training.is_registered) { %>
                            <button type="button" class="db-btn-action" disabled>Registered</button>
                          <% } else { %>
                            <a href="/account/trainings/<%= training.id %>/register" class="db-btn-action">
                              Register
                            </a>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align:center; color:#9ca3af; padding: 1.5rem 0;">
                        No upcoming trainings at the moment.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            
              <a href="#" id="trainingOpportunitiesLink" class="db-view-all">
                View all trainings <i class="bi bi-arrow-right"></i>
              </a>
            </div>
            
            <div class="db-card">
              <div class="db-panel-title">Job Opportunities</div>
              <table class="db-table">
                <thead>
                  <tr><th>Job Title</th><th>Deadline</th><th>Location</th><th></th></tr>
                </thead>
                <tbody>
                  <% if (jobs && jobs.length > 0) { %>
                    <% jobs.forEach(job => { %>
                      <tr>
                        <td><%= job.title %></td>
                        <td><%= new Date(job.end_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                        <td><%= job.region %></td>
                        <td><a href="/jobs/<%= job.id %>/apply" class="db-btn-action">Apply</a></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="4" style="text-align:center; color:#9ca3af;">No open job postings right now.</td></tr>
                  <% } %>
                </tbody>
              </table>
              <a href="#" class="db-view-all">View all jobs <i class="bi bi-arrow-right"></i></a>
            </div>

          </div>

          <!-- ===================== APPLICATIONS + EVENTS + PROFILE SUMMARY ===================== -->
          <div class="db-member-bottom-grid">

            <div class="db-card">
              <div class="db-panel-title">My Applications</div>
            
              <% if (typeof myApplications !== 'undefined' && myApplications.length > 0) { %>
                <% myApplications.forEach(app => { %>
                  <div class="db-application-item">
                    <div>
                      <span><%= app.job_title %></span>
                      <small>
                        Applied on 
                        <%= new Date(app.created_at).toLocaleDateString('en-GB', {
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric'
                        }) %>
                      </small>
                    </div>
            
                    <% 
                      let badgeClass = 'db-badge-progress';
                      const status = (app.status || '').toLowerCase();
            
                      if (status === 'shortlisted')        badgeClass = 'db-badge-shortlisted';
                      else if (status === 'rejected')      badgeClass = 'db-badge-rejected';
                      else if (status === 'hired' || status === 'accepted') badgeClass = 'db-badge-hired';
                      else if (status === 'under review' || status === 'pending') badgeClass = 'db-badge-progress';
                    %>
                    <span class="db-badge-status <%= badgeClass %>">
                      <%= app.status %>
                    </span>
                  </div>
                <% }) %>
              <% } else { %>
                <div style="padding: 1.8rem 0; text-align: center; color: #9ca3af;">
                  <i class="bi bi-briefcase" style="font-size: 1.9rem; display: block; margin-bottom: 8px;"></i>
                  No applications yet
                </div>
              <% } %>
            
              <a href="#" id="myApplicationsLink" class="db-view-all">
                View all applications <i class="bi bi-arrow-right"></i>
              </a>
            </div>
            <div class="db-card">
              <div class="db-panel-title">My Upcoming Events</div>
            
              <% if (typeof upcomingEvents !== 'undefined' && upcomingEvents.length > 0) { %>
                <% upcomingEvents.forEach(event => { %>
                  <div class="db-event-item">
                    <i class="bi bi-calendar-event db-event-icon"></i>
                    <div>
                      <span><%= event.title %></span>
                      <small>
                        <%= new Date(event.event_date).toLocaleDateString('en-GB', {
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric'
                        }) %>
                        &middot;
                        <%= event.location || 'Online' %>
                      </small>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div style="padding: 1.8rem 0; text-align: center; color: #9ca3af;">
                  <i class="bi bi-calendar-x" style="font-size: 1.9rem; display: block; margin-bottom: 8px;"></i>
                  No upcoming events
                </div>
              <% } %>
            
              <a href="#" class="db-view-all">
                View all events <i class="bi bi-arrow-right"></i>
              </a>
            </div>
            
            <div class="db-card db-profile-summary-card">
              <div class="db-panel-title">Profile Summary</div>
            
              <div class="db-profile-summary-body">
                <div class="db-profile-summary-info">
                  <div class="db-profile-row">
                    <span>Full Name</span>
                    <b><%= account.full_name || '—' %></b>
                  </div>
            
                  <div class="db-profile-row">
                    <span>Email</span>
                    <b><%= account.email || '—' %></b>
                  </div>
            
                  <div class="db-profile-row">
                    <span>Phone</span>
                    <b><%= profile.Phone || account.Phone || '—' %></b>
                  </div>
            
                  <div class="db-profile-row">
                    <span>Location</span>
                    <b>
                      <% 
                        const locationParts = [
                          birthPlace?.region,
                          birthPlace?.district
                        ].filter(Boolean);
                      %>
                      <%= locationParts.length > 0 ? locationParts.join(', ') : '—' %>
                    </b>
                  </div>
            
                  <a href="#" id="updateProfileLink" class="db-view-all">
                    Complete Profile <i class="bi bi-arrow-right"></i>
                  </a>
                </div>
            
                <!-- Progress Ring -->
                <div class="db-progress-ring" style="--progress: <%= profileCompletion %>%;">
                  <div class="db-progress-ring-hole">
                    <%= profileCompletion %>%
                  </div>
                </div>
              </div>
            </div>
            </div>
             <div class="bottom-footer-yasnet">
             <div class="footer-title">
              <p>Copyright &copy;<span id="year"></span>  <span class="yasnet">Yasnet Portal.</span> Designed By <small class="yas">Yasnet Developers</small> </p>
              </div>
            </div>

        </div> <!-- End of #dbMainContent -->
         <!-- ✅ Change Password panel — sibling of #dbMainContent, hidden by default -->
         <div id="changePasswordPanel" class="db-card" style="display:none; max-width: 480px; margin: 0 auto;">
          <div class="step-header" style="text-align:center; margin-bottom: 24px;">
            <div class="step-number" style="margin: 0 auto 12px;"><i class="bi bi-key"></i></div>
            <h2>Change Password</h2>
            <p>Keep your account secure by updating your password</p>
          </div>

          <form action="/account/change-password" method="POST" class="auth-form" id="changePasswordForm">
             
            <div class="form-field"id="passwordField">
              <label for="password">Current Password</label>
              <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input type="password" id="currentPassword" name="current_password" autocomplete="current-password" placeholder="Enter your current password" required>
                <i class="bi bi-eye toggle-visibility" data-target="currentPassword"></i>
              </div>
            </div>

            <div class="form-field">
              <label>New Password</label>
              <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input type="password" id="newPassword" name="new_password" placeholder="Create a new password" pattern="^.{8,}$" required>
                <i class="bi bi-eye toggle-visibility" data-target="newPassword"></i>
              </div>
              <small class="field-hint">At least 8 characters, with uppercase, lowercase, a number, and a symbol.</small>
            </div>

            <div class="form-field">
              <label>Confirm New Password</label>
              <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input type="password" id="confirmNewPassword" name="confirm_new_password" placeholder="Confirm your new password" pattern="^.{8,}$" required>
                <i class="bi bi-eye toggle-visibility" data-target="confirmNewPassword"></i>
              </div>
              <div id="newPasswordMatchError" class="field-error"></div>
            </div>

            <button type="submit" class="btn btn-filled btn-block btn-lg" style="margin-top: 12px;">
              Update Password
            </button>

            <div class="auth-switch" style="margin-top:20px;text-align:center;">
              <a href="#" id="cancelChangePassword"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
            </div>

          </form>
        </div>
        <!-- end #changePasswordPanel -->
        <!-- ===================== FULL PANELS (Outside main content) ===================== -->
        <%- include('job-opportunities') %>
        <%- include('my-applications') %>
        <%- include('training-opportunities') %>
        <%- include('create-ticket') %>
        <%- include('my-messages') %>
        <%- include('member-profile') %>

      </div>
    </div>
  </div>