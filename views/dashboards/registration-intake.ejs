<div id="registrationIntakePanel" class="db-card" style="display:none; max-width: 640px; margin: 0 auto;">
  <div class="step-header" style="text-align:center; margin-bottom:24px;">
    <div class="step-number" style="margin:0 auto 12px;"><i class="bi bi-door-open"></i></div>
    <h2>Registration Intake</h2>
    <p>Open or close member registration</p>
  </div>

  <% if (activeIntake) { %>
    <div style="background:var(--bg-light-green, #e8f5e9); border-radius:12px; padding:16px 18px; margin-bottom:24px;">
      <p style="font-weight:700; color:var(--primary-green, #2e7d32); margin-bottom:6px;">
        <i class="bi bi-check-circle"></i> Currently Open: <%= activeIntake.intake_name %>
      </p>
      <p style="font-size:0.85rem; color:var(--text-secondary, #4b5563);">
        <%= new Date(activeIntake.open_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        &mdash;
        <%= new Date(activeIntake.close_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
      </p>
      <form action="/account/intakes/<%= activeIntake.id %>/close" method="POST" onsubmit="return confirm('Close registration now?');" style="margin-top:12px;">
        <button type="submit" class="btn btn-outline" style="color:#c0392b; border-color:#c0392b;">
          <i class="bi bi-lock"></i> Close Registration Now
        </button>
      </form>
    </div>
  <% } else { %>
    <div style="background:#fff8e1; border-radius:10px; padding:14px 16px; margin-bottom:24px; text-align:center; color:#f57f17; font-size:0.88rem;">
      <i class="bi bi-exclamation-circle"></i> Registration is currently closed.
    </div>
  <% } %>

  <h3 class="profile-section-title">Open New Intake</h3>
  <form action="/account/intakes/create" method="POST" class="auth-form">
    <div class="form-field">
      <label>Intake / Round Name</label>
      <div class="input-wrap">
        <i class="bi bi-card-heading input-icon"></i>
        <input type="text" name="intake_name" placeholder="e.g. 2026 Membership Intake — Round 1" required>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label>Open Date</label>
        <div class="input-wrap">
          <i class="bi bi-calendar-check input-icon"></i>
          <input type="date" name="open_date" required>
        </div>
      </div>
      <div class="form-field">
        <label>Close Date</label>
        <div class="input-wrap">
          <i class="bi bi-calendar-x input-icon"></i>
          <input type="date" name="close_date" required>
        </div>
      </div>
    </div>

    <h4 class="profile-section-title" style="font-size:0.85rem;">Mobile Money Payment</h4>
    <div class="form-row">
      <div class="form-field">
        <label>Provider</label>
        <div class="input-wrap">
          <i class="bi bi-phone input-icon"></i>
          <select name="mobile_money_provider">
            <option value="">Select provider</option>
            <option value="M-Pesa">M-Pesa</option>
            <option value="Tigo Pesa">Tigo Pesa</option>
            <option value="Airtel Money">Airtel Money</option>
            <option value="Halopesa">Halopesa</option>
          </select>
        </div>
      </div>
      <div class="form-field">
        <label>Number</label>
        <div class="input-wrap">
          <i class="bi bi-telephone input-icon"></i>
          <input type="text" name="mobile_money_number" placeholder="e.g. 0712 345 678">
        </div>
      </div>
    </div>

    <h4 class="profile-section-title" style="font-size:0.85rem;">Bank Payment</h4>
    <div class="form-field">
      <label>Bank Name</label>
      <div class="input-wrap">
        <i class="bi bi-bank input-icon"></i>
        <select name="bank_name">
          <option value="">Select bank</option>
          <option value="CRDB Bank">CRDB Bank</option>
          <option value="NMB Bank">NMB Bank</option>
          <option value="NBC Bank">NBC Bank</option>
          <option value="Equity Bank">Equity Bank</option>
          <option value="Stanbic Bank">Stanbic Bank</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-field">
        <label>Account Name</label>
        <div class="input-wrap">
          <i class="bi bi-person input-icon"></i>
          <input type="text" name="bank_account_name" placeholder="Account holder name">
        </div>
      </div>
      <div class="form-field">
        <label>Account Number</label>
        <div class="input-wrap">
          <i class="bi bi-credit-card-2-front input-icon"></i>
          <input type="text" name="bank_account_number" placeholder="Account number">
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-filled btn-block btn-lg" style="margin-top:16px;">
      Open Registration
    </button>
  </form>

  <div class="auth-switch" style="margin-top:20px;text-align:center;">
    <a href="#" id="cancelRegistrationIntake"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
  </div>
</div>