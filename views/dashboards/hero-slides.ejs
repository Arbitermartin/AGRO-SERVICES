<div id="heroSlidesPanel" class="db-card" style="display:none; max-width:640px; margin:0 auto;">
  <div class="step-header" style="text-align:center; margin-bottom:24px;">
    <div class="step-number" style="margin:0 auto 12px;">
      <i class="bi bi-images"></i>
    </div>
    <h2>Homepage Slideshow</h2>
    <p>Post slides shown at the top of the homepage</p>
  </div>

  <form action="/account/hero-slides/create" method="POST" enctype="multipart/form-data" class="auth-form">
    <%- include('../partials/csrf-field') %>

    <div class="form-field">
      <label>Title</label>
      <div class="input-wrap">
        <i class="bi bi-type input-icon"></i>
        <input type="text" name="title" placeholder="e.g. Empowering Youth Leaders" required>
      </div>
    </div>

    <div class="form-field">
      <label>Description</label>
      <div class="input-wrap" style="align-items:flex-start;">
        <i class="bi bi-text-left input-icon" style="margin-top:12px;"></i>
        <textarea name="description" rows="3" placeholder="Short description under the title..." style="padding-left:44px;" required></textarea>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label>Primary button text</label>
        <div class="input-wrap">
          <i class="bi bi-cursor input-icon"></i>
          <input type="text" name="primary_btn_text" placeholder="Join Our Team">
        </div>
      </div>
      <div class="form-field">
        <label>Primary button link</label>
        <div class="input-wrap">
          <i class="bi bi-link-45deg input-icon"></i>
          <input type="text" name="primary_btn_link" placeholder="/account/register">
        </div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label>Secondary button text</label>
        <div class="input-wrap">
          <i class="bi bi-cursor input-icon"></i>
          <input type="text" name="secondary_btn_text" placeholder="Read More">
        </div>
      </div>
      <div class="form-field">
        <label>Secondary button link</label>
        <div class="input-wrap">
          <i class="bi bi-link-45deg input-icon"></i>
          <input type="text" name="secondary_btn_link" placeholder="/about">
        </div>
      </div>
    </div>

    <div class="form-field">
      <label>Display order</label>
      <div class="input-wrap">
        <i class="bi bi-sort-numeric-down input-icon"></i>
        <input type="number" name="display_order" min="1" value="1" required>
      </div>
    </div>

    <div class="form-field">
  <label>Background image</label>
  <div class="upload-area" id="heroSlideUploadArea">
    <i class="bi bi-cloud-upload" style="font-size:1.8rem; color:var(--primary-green); display:block; margin-bottom:8px;"></i>
    <p>Tap to upload image<br><small>JPG or PNG (max 3MB)</small></p>
    <input type="file" id="heroSlideUploadInput" name="image" accept="image/jpeg,image/png" style="display:none;" required>
  </div>
  <div id="heroSlideUploadedFile" style="display:none; margin-top:8px; font-size:0.85rem; color:var(--primary-green);">
    <i class="bi bi-file-earmark-check"></i>
    <span id="heroSlideFileName"></span>
  </div>
</div>

    <button type="submit" class="btn btn-filled btn-block btn-lg">Post slide</button>
  </form>

  <% if (allHeroSlides && allHeroSlides.length > 0) { %>
    <h3 class="profile-section-title" style="margin-top:30px;">Posted slides</h3>

    <% allHeroSlides.forEach(s => { %>
      <div class="manage-item">
        <div class="manage-item-summary">
          <% if (s.image_path) { %>
            <img src="<%= s.image_path %>" alt="" class="manage-item-thumb">
          <% } else { %>
            <div class="manage-item-thumb-placeholder"><i class="bi bi-image"></i></div>
          <% } %>
          <div class="manage-item-info">
            <h4><%= s.title %></h4>
            <small>Order: <%= s.display_order %></small>
          </div>
          <div class="manage-item-actions">
            <form action="/account/hero-slides/<%= s.id %>/delete" method="POST"
                  onsubmit="return confirm('Delete this slide permanently?');">
              <%- include('../partials/csrf-field') %>
              <button type="submit" class="btn-outline-sm manage-delete-btn">
                <i class="bi bi-trash"></i> Delete
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>

  <div class="auth-switch" style="margin-top:20px; text-align:center;">
    <a href="#" id="cancelHeroSlides">
      <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
  </div>
</div>