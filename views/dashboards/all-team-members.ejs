        <div class="manage-edit-form" style="display:none;">
          <form action="/account/team/<%= m.id %>/update" method="POST" enctype="multipart/form-data" class="auth-form">
            <%- include('../partials/csrf-field') %>
            <div class="form-field">
              <label>Full Name</label>
              <div class="input-wrap">
                <i class="bi bi-person input-icon"></i>
