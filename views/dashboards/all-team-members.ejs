                  <i class="bi bi-envelope input-icon"></i>
                  <input type="email" name="email" value="<%= m.email || '' %>">
                </div>
              </div>
            </div>
            <div class="form-field">
              <label>Replace Photo (optional)</label>
              <div class="input-wrap">
                <i class="bi bi-image input-icon"></i>
                <input type="file" name="photo" accept="image/jpeg,image/png">
              </div>
            </div>
            <button type="submit" class="btn btn-filled" style="margin-top:10px;">Save Changes</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="text-align:center; color:#9ca3af; padding: 16px 0;">No advisory board members posted yet.</p>
  <% } %>

  <div class="auth-switch" style="margin-top:20px;text-align:center;">
    <a href="#" id="cancelAllTeamMembers"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
  </div>
</div>