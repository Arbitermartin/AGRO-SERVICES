                  <input type="number" name="display_order" min="1" value="<%= m.display_order %>" required>
                </div>
              </div>
            </div>
            <div class="form-field">
              <label>Bio</label>
              <div class="input-wrap" style="align-items:flex-start;">
                <i class="bi bi-card-text input-icon" style="margin-top:12px;"></i>
                <textarea name="bio" rows="3" style="padding-left:44px;"><%= m.bio || '' %></textarea>
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
