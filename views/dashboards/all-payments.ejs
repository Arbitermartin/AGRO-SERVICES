<div id="allPaymentsPanel" class="db-card" style="display:none;">
  <div class="step-header" style="text-align:center; margin-bottom: 24px;">
    <div class="step-number" style="margin: 0 auto 12px;"><i class="bi bi-credit-card"></i></div>
    <h2>Payments</h2>
    <p>Review pending payments and full payment history</p>
  </div>

  <h3 class="profile-section-title">Pending Review</h3>
  <table class="db-table">
    <thead>
      <tr><th>Member</th><th>Contact</th><th>Plan</th><th>Amount</th><th>Method</th><th>Transaction Ref</th><th>Proof</th><th></th></tr>
    </thead>
    <tbody>
      <% if (pendingPayments && pendingPayments.length > 0) { %>
        <% pendingPayments.forEach(p => { %>
          <tr>
            <td><b><%= p.full_name %></b></td>
            <td><%= p.email %><br><small class="db-table-muted"><%= p.phone_number %></small></td>
            <td><%= p.membership_plan %></td>
            <td>TZS <%= Number(p.amount).toLocaleString() %></td>
            <td>
              <%= p.payment_method %>
              <% if (p.payment_method === 'Bank Transfer' && p.bank_name) { %>
                <br><small class="db-table-muted"><%= p.bank_name %> &middot; <%= p.bank_account_number %></small>
              <% } %>
            </td>
            <td><%= p.transaction_reference %></td>
            <td><a href="<%= p.payment_proof %>" target="_blank"><i class="bi bi-eye"></i> View</a></td>
            <td>
              <form action="/account/payments/<%= p.id %>/approve" method="POST" style="display:inline;">
                <%- include('../partials/csrf-field') %>
                <button type="submit" class="db-btn-approve" style="padding:6px 14px;">Approve</button>
              </form>
              <form action="/account/payments/<%= p.id %>/reject" method="POST" style="display:inline;">
                <%- include('../partials/csrf-field') %>
                <button type="submit" class="db-btn-reject" style="padding:6px 14px;">Reject</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="8" style="text-align:center; color:#9ca3af; padding:20px;">No pending payments.</td></tr>
      <% } %>
    </tbody>
  </table>

  <h3 class="profile-section-title" style="margin-top:30px;">Payment History</h3>
  <table class="db-table">
    <thead>
      <tr><th>Member</th><th>Plan</th><th>Amount</th><th>Status</th><th>Date</th></tr>
    </thead>
    <tbody>
      <% if (allPaymentHistory && allPaymentHistory.length > 0) { %>
        <% allPaymentHistory.forEach(p => { %>
          <tr>
            <td><%= p.full_name %></td>
            <td><%= p.membership_plan %></td>
            <td>TZS <%= Number(p.amount).toLocaleString() %></td>
            <td>
              <span class="db-badge-status
                <%= p.payment_status === 'Approved' ? 'db-badge-open' : '' %>
                <%= p.payment_status === 'Pending' ? 'db-badge-progress' : '' %>
                <%= p.payment_status === 'Rejected' ? 'db-badge-priority db-badge-high' : '' %>
              "><%= p.payment_status %></span>
            </td>
            <td><%= new Date(p.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5" style="text-align:center; color:#9ca3af; padding:20px;">No payment history yet.</td></tr>
      <% } %>
    </tbody>
  </table>

  <div class="auth-switch" style="margin-top:20px;text-align:center;">
    <a href="#" id="cancelAllPayments"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
  </div>
</div>