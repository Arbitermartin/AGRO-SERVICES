<body class="db-body" data-role="admin">

  <div class="db-shell">
    <!-- ===================== SIDEBAR ===================== -->
    <aside class="db-sidebar" id="dbSidebar">
      <div class="db-brand">
        <i class="bi bi-shield-fill-check"></i>
        <div>
          <div class="db-brand-name">PORTAL</div>
          <div class="db-brand-sub">Admin Panel</div>
        </div>
      </div>

      <nav class="db-nav">

        <a href="/account/dashboard/admin" class="db-nav-link is-active">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <div class="db-nav-heading">Management</div>

        <div class="db-nav-group">
          <button type="button" class="db-nav-toggle" aria-expanded="false">
            <span><i class="bi bi-people"></i> Members</span>
            <i class="bi bi-chevron-down db-nav-caret"></i>
          </button>
          <div class="db-submenu">
            <a href="#" id="allMembersLink" class="db-submenu-link"> All Users</a>
            <a href="#" id="memberReferrersLink" class="db-submenu-link">
                Registration Names
             </a>
             <a href="#" id="memberLocationsLink" class="db-submenu-link">
                Member Location
             </a>
            <a href="#" id="allTeamMembersLink" class="db-submenu-link">
              <div><span>Team &amp; Advisory</span>
              </div>
            </a>
            <a href="#" id="addTestimonialLink" class="db-submenu-link">
               <div><span>Testimonials</span>
              </div>
          </a>
            
            <a href="#" class="db-submenu-link">Member Reports</a>
            <a href="#" class="db-submenu-link">Export Members</a>
          </div>
        </div>

        <div class="db-nav-group">
          <button type="button" class="db-nav-toggle" aria-expanded="false">
            <span><i class="bi bi-calendar-event"></i> Events &amp; News</span>
            <i class="bi bi-chevron-down db-nav-caret"></i>
          </button>
          <div class="db-submenu">
            <a href="#" id="addEventLink" class="db-submenu-link">
            <div><span>Add Event</span>
            </div>
          </a>
          <a href="#" id="addNewsLink" class="db-submenu-link">
            <div><span>Add News</span>
          </div>
        </a>
        <a href="#" id="allEventsLink" class="db-submenu-link"><div><span>All Events</span>
        </div>
      </a>
     <a href="#" id="registeredUsersLink" class="db-submenu-link">Registered Users</a>
            <a href="#" id="allNewsLink" class="db-submenu-link"><div><span>All News</span>
            </div>
          </a>
          </div>
        </div>

        <div class="db-nav-group">
          <button type="button" class="db-nav-toggle" aria-expanded="false">
            <span><i class="bi bi-briefcase"></i> Job Postings</span>
            <i class="bi bi-chevron-down db-nav-caret"></i>
          </button>
          <div class="db-submenu">
            <a href="#" id="allJobsLink" class="db-submenu-link"><div><span>All Job Postings</span>
            </div>
          </a>
            <a href="#" id="addJobLink" class="db-submenu-link">
              <div><span>Add Job Posting</span>
            </div>
          </a>
          <a href="#" id="applicationsLink" class="db-submenu-link"><div><span>Applications</span></div></a>
          </div>
        </div>

        <div class="db-nav-group">
          <button type="button" class="db-nav-toggle" aria-expanded="false">
            <span><i class="bi bi-mortarboard"></i> Trainings</span>
            <i class="bi bi-chevron-down db-nav-caret"></i>
          </button>
          <div class="db-submenu">
            
            <a href="#" id="addTrainingLink" class="db-submenu-link"><div><span>Add Training</span>
            </div>
           
          </a>
          <a href="#" id="registrationIntakeLink" class="db-submenu-link"> Registration Intake

          </a>
          <a href="#" id="trainingRegistrationsLink" class="db-submenu-link"><div><span>Registrations</span>
          </div>
        </a>
          </div>
        </div>

        <div class="db-nav-heading">Operations</div>

        <div class="db-nav-group">
          <button type="button" class="db-nav-toggle" aria-expanded="false">
            <span><i class="bi bi-credit-card"></i> Payments</span>
            <i class="bi bi-chevron-down db-nav-caret"></i>
          </button>
          <div class="db-submenu">
            <a href="#" class="db-submenu-link">Pending Payments</a>
            <a href="#" class="db-submenu-link">Payment History</a>
            <a href="#" class="db-submenu-link">Payment Reports</a>
            <a href="#" class="db-submenu-link">Download Payments</a>
          </div>
        </div>

        <a href="#" id="allPaymentsLink2" class="db-nav-link">
            <i class="bi bi-check2-square"></i> Approvals
           <% if (pendingPaymentCount > 0) { %>
           <span class="db-nav-badge"><%= pendingPaymentCount %></span>
         <% } %>
        </a>

        <div class="db-nav-heading">Administration</div>

        <div class="db-nav-group">
          <button type="button" class="db-nav-toggle" aria-expanded="false">
            <span><i class="bi bi-shield-lock"></i> Admins & ICT</span>
            <i class="bi bi-chevron-down db-nav-caret"></i>
          </button>
          <div class="db-submenu">
            <a href="#" id="adminManagementLink" class="db-submenu-link"> Manage Admins</a>
            <a href="#" id="addIctStaffLink" class="db-submenu-link"> Add ICT Staff

            </a>
            <a href="#" id="ictManagementLink" class="db-submenu-link">ICT Management

            </a>
            <a href="#" id="taskManagementLink" class="db-submenu-link"> Task Management

            </a>
             <a href="#" id="myTasksLink" class="db-submenu-link"> My Tasks
        </a>
            <a href="#" class="db-submenu-link">Admin Activity</a>
            <a href="#" class="db-submenu-link">Send Credentials</a>
          </div>
        </div>

        <div class="db-nav-heading">System</div>

        <a href="#" class="db-nav-link"><i class="bi bi-bar-chart"></i> Reports</a>
        <a href="#" class="db-nav-link"><i class="bi bi-envelope"></i> Messages</a>

        <div class="db-nav-footer">
          <a href="#" class="db-nav-link"><i class="bi bi-gear"></i> Settings</a>
          <a href="/login" class="db-nav-link"><i class="bi bi-box-arrow-right"></i> Logout</a>
        </div>
      </nav>
    </aside>

    <div class="db-main">
      <!-- ===================== TOP BAR ===================== -->
      <header class="db-topbar">
        <div class="db-topbar-left">
          <button type="button" class="db-sidebar-toggle" id="dbSidebarToggle" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
          </button>
          <div>
            <div class="db-welcome">Welcome, <%= account.full_name %></div>
            <div class="db-role">
              Role:<%= account.account_type %>
              <% if (account.is_online){%>
              <span class="online-status"><span class="online-dot"></span> Online</span>
              <%}%>
            </div>
          </div>
        </div>

        <div class="db-topbar-title">ADMIN DASHBOARD</div>

        <div class="db-topbar-right">

         <div class="db-search" style="position: relative;">
          <i class="bi bi-search"></i>
          <input type="text" id="dashboardSearchInput" placeholder="Search tickets or users...">
          <div id="dashboardSearchResults" class="search-results-dropdown" style="display:none;"></div>
        </div>
           <div class="db-notif-menu">
           <button type="button" class="db-icon-btn" id="notifToggle" aria-label="Notifications">
           <i class="bi bi-bell"></i>
             <span class="db-notif-count" id="notifCount" style="display:none;">0</span>
              </button>
           <div class="db-notif-dropdown" id="notifDropdown">
           <div class="db-notif-header">
            <span>Notifications</span>
            <a href="#" id="markAllReadBtn">Mark all read</a>
           </div>
          <div class="db-notif-list" id="notifList">
          <p class="db-notif-empty">Loading...</p>
         </div>
       </div>
      </div>


          <!-- User menu -->
          <div class="db-user-menu">
            <button type="button" class="db-user-toggle" id="dbUserToggle" aria-haspopup="true" aria-expanded="false">
              <span class="db-avatar">
                  <% if (account.profile_photo) { %>
                  <img src="<%= account.profile_photo %>" alt="" class="db-avatar-img">
                 <% } else { %>
                 <%= initials %>
                <% } %>
              </span>
              <span class="db-user-name"><%= account.full_name %></span>
              <i class="bi bi-chevron-down db-user-caret"></i>
            </button>

            <div class="db-user-dropdown" id="dbUserDropdown">
              <div class="db-user-dropdown-head">
                <span class="db-avatar db-avatar-lg">
                    <% if (account.profile_photo) { %>
                   <img src="<%= account.profile_photo %>" alt="" class="db-avatar-img">
                  <% } else { %>
               <%= initials %>
              <% } %>
                </span>
                <div>
                  <div class="db-user-dropdown-name"><%= account.full_name %></div>
                  <div class="db-user-dropdown-email"><%= account.email %></div>
                </div>
              </div>
              <div class="db-user-dropdown-divider"></div>
              <a href="#" id="updateProfileLink" class="db-user-dropdown-item">
                <i class="bi bi-person"></i> Update Profile
              </a>
              <a href="#" id="changePasswordLink" class="db-user-dropdown-item">
                <i class="bi bi-key"></i> Change Password
              </a>
              <div class="db-user-dropdown-divider"></div>
              <a href="/account/logout" class="db-user-dropdown-item db-user-dropdown-danger">
                <i class="bi bi-box-arrow-right"></i> Logout
              </a>
            </div>
          </div>
        </div>
      </header>

      <div class="db-content">
        <div id="toastContainer" class="toast-container">
          <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <% success.forEach(msg => { %>
              <div class="toast-msg success">
                <i class="bi bi-check-circle-fill"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          <% } else if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <% error.forEach(msg => { %>
              <div class="toast-msg error">
                <i class="bi bi-x-circle-fill"></i>
                <span><%= msg %></span>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- ✅ Everything that should be HIDDEN when Change Password is shown -->
        <div id="dbMainContent">

          <!-- ===================== STAT CARDS ===================== -->
          <div class="db-stats-grid">
            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-green"><i class="bi bi-people-fill"></i></div>
              <div>
                <div class="db-stat-label">Total Members</div>
                <div class="db-stat-value"><%= totalMembers %></div>
                <div class="db-stat-delta db-stat-delta-green">&uarr; <%= newMembersThisMonth %> this month</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-blue"><i class="bi bi-calendar-event-fill"></i></div>
              <div>
                <div class="db-stat-label">Events</div>
                <div class="db-stat-value"><%= eventCount %></div>
                <div class="db-stat-delta db-stat-delta-blue"><%= upcomingEventCount %> upcoming</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-green"><i class="bi bi-briefcase-fill"></i></div>
              <div>
                <div class="db-stat-label">Job Postings</div>
                <div class="db-stat-value"><%= jobCount %></div>
                <div class="db-stat-delta db-stat-delta-green"><%= openJobCount %> active</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-orange"><i class="bi bi-mortarboard-fill"></i></div>
              <div>
                <div class="db-stat-label">Trainings</div>
                <div class="db-stat-value"><%= allTrainingRegistrations.length %></div>
                <div class="db-stat-delta db-stat-delta-orange">4 upcoming</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-yellow"><i class="bi bi-hourglass-split"></i></div>
              <div>
                <div class="db-stat-label">Pending Payments</div>
                <div class="db-stat-value"><%= pendingPaymentCount %></div>
                <div class="db-stat-delta db-stat-delta-yellow">Your approval</div>
              </div>
            </div>

            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-purple"><i class="bi bi-shield-fill"></i></div>
              <div>
                <div class="db-stat-label">Admins</div>
                <div class="db-stat-value"><%= totalAdmins %></div>
                <div class="db-stat-delta db-stat-delta-purple">
                <a href="#" id="viewAllAdminsLink" style="color:inherit; text-decoration:none;">View all</a>
               </div>
              </div>
            </div>
          </div>

          <!-- ===================== MANAGEMENT PANELS ===================== -->
          <div class="db-panels-grid">
            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-green"><i class="bi bi-people-fill"></i></div>
              <div>
                <div class="db-stat-label">Total Members</div>
                <div class="db-stat-value"><%memberStats.total%></div>
                <div class="db-stat-delta db-stat-delta-green">
                  &uarr; <%= memberStats.thisMonth%> in <%= memberStats.monthLabel%>
                  </div>
              </div>
            </div>
            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-blue"><i class="bi bi-calendar-event-fill"></i></div>
              <div>
                <div class="db-stat-label">Events</div>
                <div class="db-stat-value"><%=eventCount%></div>
                <div class="db-stat-delta db-stat-delta-blue"><%=upcomingEventCount%> Upcoming</div>
              </div>
            </div>
            <div class="db-stat-card">
              <div class="db-stat-icon db-stat-icon-green"><i class="bi bi-briefcase-fill"></i></div>
              <div>
                <div class="db-stat-label">Job Postings</div>
                <div class="db-stat-value"><%=jobCount%></div>
                <div class="db-stat-delta db-stat-delta-green"><%=openJobCount%> Open Jobs</div>
              </div>
            </div>
          <div class="db-stat-card">
            <div class="db-stat-icon db-stat-icon-orange"><i class="bi bi-mortarboard-fill"></i></div>
            <div>
              <div class="db-stat-label">Training</div>
              <div class="db-stat-value"><%=allTrainingRegistrations.length%></div>
               <div class="db-stat-delta db-stat-delta-orange">registrations</div>
            </div>
          </div>
          <div class="db-stat-card">
            <div class="db-stat-icon db-stat-icon-yellow"><i class="bi bi-hourglass-split"></i></div>
            <div>
              <div class="db-stat-label">Pending Payments</div>
              <div class="db-stat-value"><%=pendingPaymentCount%></div>
              <div class="db-stat-delta db-stat-delta-yellow">
                 <a href="#" id="allPaymentsLink" style="color:inherit;text-decoration:none;">Review now</a>
              </div>
            </div>
          </div>

          <div class="db-stat-card">
            <div class="db-stat-icon db-stat-icon-purple"><i class="bi bi-shield-fill"></i></div>
            <div>
              <div class="db-stat-label">Admins</div>
              <div class="db-stat-label"><%=totalAdmins%></div>
              <div class="db-stat-delta db-stat-delta-purple">
                <a href="#" id="viewAllAdminsLink" style="color:inherit;text-decoration:none;">View all</a>
              </div>
            </div>
          </div>
          </div>

          <!-- ===================== BOTTOM ROW ===================== -->
          <div class="db-bottom-grid">
            
            <div class="db-card db-chart-card">
              <div class="db-panel-title" style="display: flex; align-items: center; justify-content:space-between;">
                <span>Members Registrations Overview</span>
                <% if (monthlyRegistrations.length >= 2) {
                 const latest = monthlyRegistrations[monthlyRegistrations.length - 1].count;
                 const prev = monthlyRegistrations[monthlyRegistrations.length - 2].count;
                const diff = latest - prev;
                const pct = prev > 0 ? Math.round((diff / prev) * 100) : 0;
                   %>
                   <span style="font-size:0.82rem; font-weight:700;">
                    <i class="bi bi-<%= diff >= 0 ? 'arrow-up' : 'arrow-down' %>"></i>
                    <%= Math.abs(pct)%>% vs last month
                      </span>
                <%}%>
                <% if(canDownloadChart){%>
                <button type="button" id="downloadChartBtn" class="btn-outline-sm">
                  <i class="bi bi-download"></i> Download
                </button>
                <%}%>
              </div>
              <canvas id="registrationsChart" height="140"></canvas>
              <script id="registrationsChartData" type="application/json">
                <%- JSON.stringify(monthlyRegistrations)%> 
              </script>
            </div>


             <div class="db-card">
              <div class="db-panel-title">Recent Activities</div>
                   <% if (recentActivity && recentActivity.length > 0) { %>
                       <% recentActivity.forEach(act => { %>
                  <div class="db-activity-item">
                     <i class="bi bi-activity db-activity-icon db-activity-blue"></i>
                       <div>
                         <span><%= act.full_name %></span>
                          <small><%= act.action %> &middot; <%= new Date(act.created_at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></small>
                      </div>
                     </div>
                       <% }) %>
                     <% } else { %>
                 <p style="text-align:center; color:#9ca3af; padding:16px 0;">No recent activity.</p>
                 <% } %>
                 <a href="#" class="db-view-all">View all activities <i class="bi bi-arrow-right"></i></a>
                </div>

            <div class="db-card db-events-card">
              <div class="db-panel-title">Upcoming Events</div>
               <table class="db-table">
               <thead>
                <tr><th>Event</th><th>Date</th><th>Location</th><th>Registrations</th><th>Status</th></tr>
             </thead>
              <tbody>
                <% if (upcomingEventsForDashboard && upcomingEventsForDashboard.length > 0) { %>
                 <% upcomingEventsForDashboard.forEach(ev => { %>
                 <tr>
                     <td><%= ev.title %></td>
                     <td><%= new Date(ev.event_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                     <td><%= ev.location || 'TBA' %></td>
                     <td><%= ev.registration_count %></td>
                     <td><span class="db-badge-open">Open</span></td>
                     </tr>
                     <% }) %>
                  <% } else { %>
                    <tr><td colspan="5" style="text-align:center; color:#9ca3af; padding:16px;">No upcoming events.</td></tr>
                   <% } %>
                   </tbody>
                     </table>
                   <a href="#" id="dashboardViewAllEventsLink" class="db-view-all">View all events <i class="bi bi-arrow-right"></i></a>
               </div>

           

            <div class="db-card">
          <div class="db-panel-title">Pending Approvals</div>

          <% if (recentPendingPayments && recentPendingPayments.length > 0) { %>
        <% recentPendingPayments.forEach(p => { %>
          <div class="db-approval-item">
        <span class="db-approval-avatar"><%= p.full_name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %></span>
        <div class="db-approval-info">
          <span><%= p.full_name %></span>
          <small>Payment for <%= p.membership_plan %> Membership</small>
          <small class="db-approval-amount">TZS <%= Number(p.amount).toLocaleString() %></small>
        </div>
        <div class="db-approval-actions">
          <form action="/account/payments/<%= p.id %>/approve" method="POST" style="display:inline;">
            
            <button type="submit" class="db-btn-approve">Approve</button>
          </form>
          <form action="/account/payments/<%= p.id %>/reject" method="POST" style="display:inline;">
         
            <button type="submit" class="db-btn-reject">Reject</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p style="text-align:center; color:#9ca3af; padding:16px 0;">No pending payments.</p>
  <% } %>

  <a href="#" id="allPaymentsLink" class="db-view-all">View all payments <i class="bi bi-arrow-right"></i></a>
        </div>
       </div>
       <div class="bottom-footer-yasnet">
             <div class="footer-title">
              <p>Copyright &copy; <span id="year"></span>  <span class="yasnet">Yasnet Portal.</span> Designed By <small class="yas">Yasnet Developers</small> </p>
              </div>
            </div>
          <!-- end db-bottom-grid -->
         
    </div>
     
        <!-- end #dbMainContent -->

        <!-- ✅ Change Password panel — sibling of #dbMainContent, hidden by default -->
        <div id="changePasswordPanel" class="db-card" style="display:none; max-width: 480px; margin: 0 auto;">
          <div class="step-header" style="text-align:center; margin-bottom: 24px;">
            <div class="step-number" style="margin: 0 auto 12px;"><i class="bi bi-key"></i></div>
            <h2>Change Password</h2>
            <p>Keep your account secure by updating your password</p>
          </div>

          <form action="/account/change-password" method="POST" class="auth-form" id="changePasswordForm">
          

            <div class="form-field"id="passwordField">
              <label for="password">Current Password</label>
              <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input type="password" id="currentPassword" name="current_password" autocomplete="current-password" placeholder="Enter your current password" required>
                <i class="bi bi-eye toggle-visibility" data-target="currentPassword"></i>
              </div>
            </div>

            <div class="form-field">
              <label>New Password</label>
              <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input type="password" id="newPassword" name="new_password" placeholder="Create a new password" pattern="^.{8,}$" required>
                <i class="bi bi-eye toggle-visibility" data-target="newPassword"></i>
              </div>
              <small class="field-hint">At least 8 characters, with uppercase, lowercase, a number, and a symbol.</small>
            </div>

            <div class="form-field">
              <label>Confirm New Password</label>
              <div class="input-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input type="password" id="confirmNewPassword" name="confirm_new_password" placeholder="Confirm your new password" pattern="^.{8,}$" required>
                <i class="bi bi-eye toggle-visibility" data-target="confirmNewPassword"></i>
              </div>
              <div id="newPasswordMatchError" class="field-error"></div>
            </div>

            <button type="submit" class="btn btn-filled btn-block btn-lg" style="margin-top: 12px;">
              Update Password
            </button>

            <div class="auth-switch" style="margin-top:20px;text-align:center;">
              <a href="#" id="cancelChangePassword"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
            </div>

          </form>
        </div>
        <!-- end #changePasswordPanel -->
         <!-- ✅ Update Profile panel — sibling of #dbMainContent, hidden by default -->
       <div id="updateProfilePanel" class="db-card" style="display:none; max-width: 640px; margin: 0 auto;">
     <div class="step-header" style="text-align:center; margin-bottom: 24px;">
    <div class="step-number" style="margin: 0 auto 12px;"><i class="bi bi-person-gear"></i></div>
    <h2>Update Profile</h2>
    <p>Keep your personal and work details up to date</p>
  </div>

  <form action="/account/update-profile" method="POST" class="auth-form" id="updateProfileForm">
  
      <div class="form-field" style="text-align:center;">
    <label>Profile Photo</label>
    <div class="profile-photo-upload" id="profilePhotoUpload">
      <% if (account.profile_photo) { %>
        <img src="<%= account.profile_photo %>" alt="" id="profilePhotoPreview" class="profile-photo-preview">
      <% } else { %>
        <div class="profile-photo-placeholder" id="profilePhotoPreview"><%= initials %></div>
      <% } %>
      <div class="profile-photo-edit-badge"><i class="bi bi-camera-fill"></i></div>
    </div>
    <input
      type="file"
      id="profilePhotoInput"
      name="profile_photo"
      accept="image/jpeg,image/png,image/webp"
      style="display:none;"
    >
    <small class="field-hint">JPG, PNG, or WEBP. Max 2MB.</small>
  </div>


    <h3 class="profile-section-title">Personal Information</h3>

    <div class="form-field">
      <label>Full Name</label>
      <div class="input-wrap">
        <i class="bi bi-person input-icon"></i>
        <input type="text" name="full_name" value="<%= account.full_name %>" required>
      </div>
    </div>

    <div class="form-field">
      <label>Email</label>
      <div class="input-wrap">
        <i class="bi bi-envelope input-icon"></i>
        <input type="email" value="<%= account.email %>" disabled>
      </div>
      <small class="field-hint">Email cannot be changed. Contact ICT support if this needs to update.</small>
    </div>

    <div class="form-field">
      <label>Date of Birth</label>
      <div class="input-wrap">
        <i class="bi bi-calendar-event input-icon"></i>
        <input type="date" name="date_of_birth" value="<%= profile.date_of_birth || '' %>">
      </div>
    </div>

    <div class="form-field">
      <label>Gender</label>
      <div class="input-wrap">
        <i class="bi bi-person-badge input-icon"></i>
        <select name="gender">
          <option value="">Select gender</option>
          <option value="male" <%= profile.gender === 'male' ? 'selected' : '' %>>Male</option>
          <option value="female" <%= profile.gender === 'female' ? 'selected' : '' %>>Female</option>
          <option value="other" <%= profile.gender === 'other' ? 'selected' : '' %>>Other</option>
        </select>
      </div>
    </div>

    <div class="form-field">
      <label>Nationality</label>
      <div class="input-wrap">
        <i class="bi bi-flag input-icon"></i>
        <input type="text" name="nationality" value="<%= profile.nationality || '' %>" placeholder="e.g. Tanzanian">
      </div>
    </div>

    <div class="form-field">
      <label>Bio</label>
      <div class="input-wrap" style="align-items:flex-start;">
        <i class="bi bi-card-text input-icon" style="margin-top: 12px;"></i>
        <textarea name="bio" rows="3" placeholder="A short bio about yourself" style="padding-left:44px;"><%= profile.bio || '' %></textarea>
      </div>
    </div>

    <h3 class="profile-section-title">Place of Birth</h3>

    <div class="form-row">
      <div class="form-field">
        <label>Region</label>
        <div class="input-wrap">
          <i class="bi bi-geo-alt input-icon"></i>
          <input type="text" name="region" value="<%= birthPlace.region || '' %>">
        </div>
      </div>

      <div class="form-field">
        <label>District</label>
        <div class="input-wrap">
          <i class="bi bi-geo input-icon"></i>
          <input type="text" name="district" value="<%= birthPlace.district || '' %>">
        </div>
      </div>

      <div class="form-field">
        <label>Ward</label>
        <div class="input-wrap">
          <i class="bi bi-pin-map input-icon"></i>
          <input type="text" name="ward" value="<%= birthPlace.ward || '' %>">
        </div>
      </div>
    </div>

    <h3 class="profile-section-title">Work Details</h3>

    <div class="form-row">
      <div class="form-field">
        <label>Department</label>
        <div class="input-wrap">
          <i class="bi bi-building input-icon"></i>
          <input type="text" name="department" value="<%= adminDetails.department || '' %>">
        </div>
      </div>

      <div class="form-field">
        <label>Office</label>
        <div class="input-wrap">
          <i class="bi bi-building-gear input-icon"></i>
          <input type="text" name="office" value="<%= adminDetails.office || '' %>">
        </div>
      </div>

      <div class="form-field">
        <label>Admin Role</label>
        <div class="input-wrap">
          <i class="bi bi-award input-icon"></i>
          <input type="text" name="admin_role" value="<%= adminDetails.admin_role || '' %>" placeholder="e.g. Super Administrator">
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-filled btn-block btn-lg" style="margin-top: 20px;">
      Save Changes
    </button>

    <div class="auth-switch" style="margin-top:20px;text-align:center;">
      <a href="#" id="cancelUpdateProfile"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
    </div>

  </form>
</div>
