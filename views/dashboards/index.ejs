<body class="db-body" data-role="admin">

  <div class="db-shell">
    <!-- ===================== SIDEBAR ===================== -->
    <aside class="db-sidebar" id="dbSidebar">
      <div class="db-brand">
        <i class="bi bi-shield-fill-check"></i>
        <div>
