<div id="memberLocationsPanel" class="db-card" style="display:none;">
  <div class="step-header" style="text-align:center; margin-bottom:24px;">
    <h2>Member Locations</h2>
    <p>GPS coordinates captured during registration</p>
  </div>

  <div id="memberLocationsMap" style="height:420px; border-radius:12px;"></div>

  <script id="memberLocationsData" type="application/json">
    <%- JSON.stringify(memberLocations) %>
  </script>

  <table class="db-table" style="margin-top:20px;">
    <thead><tr><th>Member</th><th>Latitude</th><th>Longitude</th><th>Captured</th></tr></thead>
    <tbody>
      <% memberLocations.forEach(m => { %>
        <tr>
          <td><%= m.full_name %></td>
          <td><%= m.latitude %></td>
          <td><%= m.longitude %></td>
          <td><%= new Date(m.location_captured_at).toLocaleDateString('en-GB') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="auth-switch" style="margin-top:20px;text-align:center;"><a href="#" id="cancelMemberLocations">Back to Dashboard</a></div>
</div>