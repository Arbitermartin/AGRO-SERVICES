<div class="forgot-wrapper">
  <div class="forgot-card">
    <!-- Logo -->
    <div class="logo">
      <img src="/images/site/logo.webp" alt="">
      <span>YASNET <sup style="border: 1px solid #000; padding: .7rem; border-radius: 50%; font-size: 15px;">TZ</sup></span>
    </div>

    <h1>Forgot Password?</h1>
    <p class="subtitle">
      Enter your email address and we’ll send you a link to reset your password.
    </p>

    <!-- Flash messages (toast) -->
    <div id="toastContainer" class="toast-container">
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <% success.forEach(msg => { %>
          <div class="toast-msg success">
            <i class="bi bi-check-circle-fill"></i>
            <span><%= msg %></span>
          </div>
        <% }) %>
      <% } else if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <% error.forEach(msg => { %>
          <div class="toast-msg error">
            <i class="bi bi-x-circle-fill"></i>
            <span><%= msg %></span>
          </div>
        <% }) %>
      <% } %>
    </div>

    <form action="/account/forgot-password" method="POST" class="forgot-form">
  
      <div class="input-group">
        <i class="bi bi-envelope"></i>
        <input
          type="email"
          name="email"
          placeholder="Enter your email address"
          required
          autocomplete="email"
        />
      </div>

      <button type="submit" class="btn-primary">Send Reset Link</button>
    </form>

    <div class="divider"></div>

    <a href="/account/login" class="back-link"><i class="bi bi-arrow-left"></i> Back to Login</a>
  </div>
</div>