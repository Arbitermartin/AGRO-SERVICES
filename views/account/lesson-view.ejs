<section class="auth-page">
  <div class="container" style="max-width: 720px;">

    <%- messages() %>

    <div class="db-card">
      <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border-color); padding-bottom:16px; margin-bottom:20px;">
        <div>
          <h2 style="margin:0; font-size:1.1rem;"><%= lesson.title %></h2>
          <small style="color:var(--text-muted);">Lesson <%= lesson.lesson_order %> of <%= allLessons.length %></small>
        </div>
      </div>

      <p style="color:var(--text-secondary); line-height:1.7; margin-bottom:20px;"><%= lesson.description %></p>

      <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:24px;">
        <% if (materials && materials.length > 0) { %>
          <% materials.forEach(m => { %>
            <div style="display:flex; align-items:center; gap:10px; padding:12px; background:var(--bg-light-green); border-radius:10px;">
              <i class="bi <%= m.file_type === 'pdf' ? 'bi-file-earmark-pdf' : m.file_type === 'video' ? 'bi-play-circle' : 'bi-file-earmark-text' %>" style="font-size:1.2rem; color:var(--primary-green);"></i>
              <span style="flex:1; font-size:0.9rem;"><%= m.title %></span>
              <a href="<%= m.file_path %>" download><i class="bi bi-download"></i></a>
            </div>
          <% }) %>
        <% } else { %>
          <p style="color:#9ca3af;">No materials uploaded for this lesson yet.</p>
        <% } %>
      </div>

      <div style="display:flex; gap:10px;">
        <a href="/account/dashboard/member" class="btn btn-outline">Back to dashboard</a>
        <form action="/account/lessons/<%= lesson.lesson_id %>/complete" method="POST" style="flex:1;">
          <button type="submit" class="btn btn-filled btn-block">
            <%= completedLessonIds.includes(lesson.lesson_id) ? 'Continue' : 'Mark complete and continue' %>
          </button>
        </form>
      </div>
    </div>

  </div>
</section>