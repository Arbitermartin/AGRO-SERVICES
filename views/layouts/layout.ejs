<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <!--  -->
    <!-- script for charts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>

    <!-- view map -->
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
     <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

     <!-- FACE ID RECOGNICION  -->
  <script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@9.0.1/dist/bundle/index.umd.min.js"></script>
  <!-- FACE ID -->

</head>

<body>
    <!-- Conditionally show Navigation -->
    <% if (typeof showNav === 'undefined' || showNav === true) { %>
        <%- include('../partials/navigation') %>
    <% } %>

    <main>
        <%- body %>
    </main>

    <!-- Conditionally show Footer -->
    <% if (typeof showFooter === 'undefined' || showFooter === true) { %>
        <%- include('../partials/footer') %>
    <% } %>
    <div class="chatbot-widget">
  <button type="button" class="chatbot-bubble" id="chatbotToggle" aria-label="Open chat assistant">
    <i class="bi bi-headset"></i>
  </button>

  <div class="chatbot-window" id="chatbotWindow" style="display:none;">
    <div class="chatbot-header">
      <div>
        <strong>AgroServices Assi
            stant</strong>
        <small>We typically reply instantly</small>
      </div>
      <button type="button" id="chatbotClose" aria-label="Close chat"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="chatbot-messages" id="chatbotMessages">
      <div class="chatbot-msg chatbot-msg-bot">
        Hi! I'm the AgroServices assistant. Ask me about registration, jobs, training, payments, or anything else.

        <br>
      <b>Note:</b> Before click any button Please provide your name first

      </div>
      <div class="chatbot-popular-questions" id="chatbotPopularQuestions">
         <p class="chatbot-popular-label">Popular questions</p>
         <div class="chatbot-quick-grid">
           <button type="button" class="chatbot-quick-pill" data-question="I forgot my email and password">Forgot email &amp; password?</button>
           <button type="button" class="chatbot-quick-pill" data-question="I want to change my email address">Change my email address</button>
           <button type="button" class="chatbot-quick-pill" data-question="I want to reset my password">Reset my password</button>
           <button type="button" class="chatbot-quick-pill" data-question="How do I register?">How do I register?</button>
         </div>

      </div>

    </div>

   

    <form class="chatbot-input-row" id="chatbotForm">
      <input type="text" id="chatbotInput" placeholder="Type your question..." autocomplete="off" required>
      <button type="submit" aria-label="Send"><i class="bi bi-send"></i></button>
    </form>
  </div>
</div>

</body>
</html>